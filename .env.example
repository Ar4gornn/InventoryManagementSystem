# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate a key:
#   openssl rand -base64 32
#   # or, without openssl:
#   dotnet run --project InventoryManagementSystem -- --help >/dev/null 2>&1; \
#   pwsh -c "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
#
# The API refuses to start without a key. There is deliberately no default: a
# fallback value in source would become the key on every deployment that forgot
# to set one.

INVENTORY_API_KEY=

# Optional. Development enables Swagger UI at /swagger.
ASPNETCORE_ENVIRONMENT=Development
